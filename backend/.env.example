OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false
PAYMENT_PROVIDER=development
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
